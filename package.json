{
  "name": "aida-dev",
  "displayName": "AIDA - AI Development Assistant",
  "description": "Advanced AI Development Assistant with intelligent code review, PR analysis, project scanning, and AIDA Chatbot. Use your own AI API (OpenAI/Claude) or GitHub Copilot. Complete development workflows for TypeScript, JavaScript, Python, C#, and more. Now with Cursor IDE support!",
  "version": "1.0.43",
  "publisher": "trongld232",
  "icon": "icons/extension-icon.png",
  "author": {
    "name": "Trong Le",
    "email": "trongld232@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/trongld230289/aida.git"
  },
  "bugs": {
    "url": "https://github.com/trongld230289/aida/issues"
  },
  "homepage": "https://github.com/trongld230289/aida#readme",
  "keywords": [
    "aida",
    "aida chatbot",
    "ai assistant",
    "development assistant",
    "code review",
    "copilot",
    "intelligent analysis",
    "project scanner"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning",
    "Linters"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**/*",
    "icons/**/*",
    "templates/**/*",
    "docs/**/*",
    "documents/**/*",
    "scripts/**/*",
    "node_modules/monaco-editor/min/**/*",
    "*.md",
    "LICENSE.txt",
    "*.png",
    "*.jpg",
    "*.html"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aida.reviewFile",
        "title": "Review File",
        "category": "AIDA"
      },
      {
        "command": "aida.reviewChanges",
        "title": "Review Changes",
        "category": "AIDA"
      },
      {
        "command": "aida.reviewAllChanges",
        "title": "Review All Changes",
        "category": "AIDA"
      },
      {
        "command": "aida.reviewPullRequest",
        "title": "Review Pull Request",
        "category": "AIDA"
      },
      {
        "command": "aida.setupAzureDevOps",
        "title": "Setup Azure DevOps Token",
        "category": "AIDA",
        "icon": "$(key)"
      },
      {
        "command": "aida.showAvailableModels",
        "title": "Show Available Language Models",
        "category": "AIDA",
        "icon": "$(library)"
      },
      {
        "command": "aida.openChat",
        "title": "Open AIDA Chat",
        "category": "AIDA",
        "icon": {
          "light": "./icons/extension-icon.svg",
          "dark": "./icons/extension-icon.svg"
        }
      },
      {
        "command": "aida.testGetCopilotModels",
        "title": "Test Get Copilot Models",
        "category": "AIDA",
        "icon": "$(globe)"
      },
      {
        "command": "aida.openSidebarChat",
        "title": "Open AIDA Sidebar Chat",
        "category": "AIDA"
      },
      {
        "command": "aida.clearChatSidebar",
        "title": "Clear Chat",
        "category": "AIDA",
        "icon": "$(clear-all)"
      },
      {
        "command": "aida.openSettingsSidebar",
        "title": "Settings",
        "category": "AIDA",
        "icon": "$(settings-gear)"
      },
      {
        "command": "aida.closeChatSidebar",
        "title": "Close Chat",
        "category": "AIDA",
        "icon": "$(close)"
      }
    ],
    "keybindings": [
      {
        "command": "aida.openChat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "when": "editorTextFocus || explorerViewletVisible"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "aida.reviewChanges",
          "group": "z_commands@1",
          "when": "editorTextFocus"
        },
        {
          "command": "aida.reviewFile",
          "group": "z_commands@2",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "aida.reviewChanges",
          "group": "navigation@1",
          "when": "resourceExtname =~ /\\.(ts|js|tsx|jsx|html|htm|css|scss|less|py|java|cs|cpp|c|php|rb|go|rs|kt|swift)$/"
        },
        {
          "command": "aida.reviewFile",
          "group": "navigation@2",
          "when": "resourceExtname =~ /\\.(ts|js|tsx|jsx|html|htm|css|scss|less|py|java|cs|cpp|c|php|rb|go|rs|kt|swift)$/"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "aida.reviewChanges",
          "group": "aida@1",
          "when": "scmResourceGroup == workingTree || scmResourceGroup == index"
        },
        {
          "command": "aida.reviewFile",
          "group": "aida@2",
          "when": "scmResourceGroup == workingTree || scmResourceGroup == index"
        }
      ],
      "view/title": [
        {
          "command": "aida.clearChatSidebar",
          "when": "view == aidaChatSidebar",
          "group": "navigation@1"
        },
        {
          "command": "aida.openSettingsSidebar",
          "when": "view == aidaChatSidebar",
          "group": "navigation@2"
        },
        {
          "command": "aida.closeChatSidebar",
          "when": "view == aidaChatSidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "AIDA",
      "properties": {
        "aida.sourceControls": {
          "type": "object",
          "default": {
            "azureDevOps": {
              "organization": "your-azure-devops-token-here",
              "anotherOrg": "another-azure-token-here"
            },
            "github": {
              "organization": "your-github-token-here",
              "anotherOrg": "your-personal-github-token"
            },
            "gitlab": {
              "organization": "your-gitlab-token-here",
              "anotherOrg": "your-personal-gitlab-token"
            }
          },
          "description": "Source control configurations with tokens for multiple organizations. Organization names come from URLs: Azure DevOps (dev.azure.com/{ORG}), GitHub (github.com/{ORG}), GitLab (gitlab.com/{GROUP}). Example: For 'https://dev.azure.com/BusinessWebUS/project' use 'BusinessWebUS' as organization name.",
          "properties": {
            "azureDevOps": {
              "type": "object",
              "description": "Azure DevOps organizations and their tokens. Organization name from URL: dev.azure.com/{ORG}/project",
              "patternProperties": {
                ".*": {
                  "type": "string",
                  "description": "Personal access token for the organization"
                }
              }
            },
            "github": {
              "type": "object",
              "description": "GitHub organizations and their tokens. Organization name from URL: github.com/{ORG}/repo",
              "patternProperties": {
                ".*": {
                  "type": "string",
                  "description": "Personal access token for the organization"
                }
              }
            },
            "gitlab": {
              "type": "object",
              "description": "GitLab groups/users and their tokens. Group name from URL: gitlab.com/{GROUP}/repo",
              "patternProperties": {
                ".*": {
                  "type": "string",
                  "description": "Personal access token for the organization"
                }
              }
            }
          }
        },
        "aida.templatesBasePath": {
          "type": "string",
          "default": "",
          "description": "Custom path for AIDA templates (e.g., '../Documents/AIDA' or '${workspaceFolder}/../Documents/AIDA'). Leave empty to use extension templates.",
          "scope": "window"
        },
        "aida.useAIDAChatbot": {
          "type": "boolean",
          "default": true,
          "description": "Enable AIDA Chatbot interface for AI-powered conversations and code assistance",
          "scope": "application"
        },
        "aida.useExternalAI": {
          "type": "boolean",
          "default": false,
          "description": "Use your own AI API key instead of GitHub Copilot for code review (useful for users without Copilot license)",
          "scope": "application"
        },
        "aida.ai.apiKey": {
          "type": "string",
          "default": "",
          "description": "AI API Key for AI-powered code analysis (OpenAI, Claude, or custom AI service)",
          "scope": "application"
        },
        "aida.ai.apiHost": {
          "type": "string",
          "default": "https://api.openai.com",
          "description": "AI API Host URL (OpenAI: https://api.openai.com, Claude: https://api.anthropic.com, or custom host)",
          "scope": "application"
        },
        "aida.ai.model": {
          "type": "string",
          "default": "Claude-4-Sonnet",
          "description": "AI Model to use for code analysis (gpt-4, gpt-5, claude-4-sonnet, or custom model)",
          "scope": "application"
        }
      }
    },
    "views": {
      "aidaChatContainer": [
        {
          "type": "webview",
          "id": "aidaChatSidebar",
          "name": "AIDA Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aidaChatContainer",
          "title": "AIDA Chat",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "review-file",
        "name": "review-file",
        "description": "📄 Review current opening file  or 🔗 specify file path",
        "isSticky": true
      },
      {
        "id": "review-changes",
        "name": "review-changes",
        "description": "🔄 Review changes for current opening file  or 🔗 specify file path",
        "isSticky": true
      },
      {
        "id": "review-all-changes",
        "name": "review-all-changes",
        "description": "🔍 Review ALL git changes in workspace (all modified files)",
        "isSticky": true
      },
      {
        "id": "review-pr",
        "name": "review-pr",
        "description": "🔍 Review Pull Request by URL",
        "isSticky": true
      },
      {
        "id": "sync-review-templates",
        "name": "sync-review-templates",
        "description": "🔄 Sync AIDA review templates to workspace",
        "isSticky": true
      },
      {
        "id": "scan-app",
        "name": "scan-app",
        "description": "🤖 AI-powered code scanning and duplicate detection",
        "isSticky": true
      },
      {
        "id": "dependency",
        "name": "dependency",
        "description": "📊 Analyze project dependencies, detect circular deps, and get architecture insights",
        "isSticky": true
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "test": "echo 'Extension test placeholder'",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "webpack": "webpack --mode development --watch",
    "package": "vsce package"
  },
  "dependencies": {
    "@vscode/vscode-languagedetection": "^1.0.22",
    "diff": "^5.2.0",
    "franc": "^6.2.0",
    "lru-cache": "^10.4.3",
    "monaco-editor": "^0.52.0",
    "natural": "^6.12.0",
    "string-similarity": "^4.0.4",
    "tesseract.js": "^6.0.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.2",
    "tree-sitter-typescript": "^0.21.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.19.0",
    "copy-webpack-plugin": "^13.0.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  }
}